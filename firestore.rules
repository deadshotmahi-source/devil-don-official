rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == "admin" && userDoc().data.status != "banned";
    }

    match /users/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /keys/{keyId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin() || resource.data.status == "unused");
      allow create, update, delete: if isAdmin();
      allow update: if signedIn()
        && resource.data.status == "unused"
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "active";
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /apk_files/{fileId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
